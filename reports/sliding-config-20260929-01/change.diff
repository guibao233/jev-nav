+class SlidingConfigTests(unittest.TestCase):
+    def read_config(self, cfg):
+        with tempfile.TemporaryDirectory() as folder:
+            path = Path(folder)/"config.json"
+            path.write_text(json.dumps(cfg))
+            return load_config(path)
+
+    def test_explicit_boolean_and_legacy_default(self):
+        for enabled in (True,False):
+            cfg = config();cfg["allow_sliding"] = enabled
+            self.assertIs(self.read_config(cfg)["allow_sliding"],enabled)
+        cfg = config();cfg.pop("allow_sliding",None)
+        self.assertIs(self.read_config(cfg)["allow_sliding"],False)
+
+    def test_ambiguous_sliding_values_rejected(self):
+        for value in ("false", "true", 0, 1, None):
+            with self.subTest(value=value):
+                cfg = config();cfg["allow_sliding"] = value
+                with self.assertRaisesRegex(ValueError,"allow_sliding must be a JSON boolean"):
+                    self.read_config(cfg)
 
 
