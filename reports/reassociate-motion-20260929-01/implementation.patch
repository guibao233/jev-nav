+def direct_navmesh_connection(pf, start, end):
+    """Validate a short reference connector on CPU, never a model action mask.
+
+    Sample the requested straight line every <=5 cm and require the movement
+    filter to reach every point without sliding away. A reachable detour alone
+    is insufficient: close points separated by a wall must not reconnect.
+    """
+    start, end = np.asarray(start, dtype=float), np.asarray(end, dtype=float)
+    if not np.isfinite(start).all() or not np.isfinite(end).all():
+        return False
+    if abs(start[1]-end[1]) > .25 or not pf.is_navigable(start) or not pf.is_navigable(end):
+        return False
+    count = max(1, int(math.ceil(float(np.linalg.norm(end-start))/.05)))
+    current = start
+    for fraction in np.linspace(0., 1., count+1)[1:]:
+        desired = start + fraction*(end-start)
+        reached = np.asarray(pf.try_step(current, desired))
+        if not np.isfinite(reached).all() or np.linalg.norm(reached-desired) > 1e-4:
+            return False
+        if not pf.is_navigable(reached):
+            return False
+        current = reached
+    return True
 
 
